<?xml version="1.0"?>
<!-- Modelo simplificado del Double 3 (cotas aproximadas de la ficha técnica pública; ajustar en el lab).
     Altura total 47"-60" (1.19-1.52 m): el pole aporta 0.33 m de recorrido.
     Frames compatibles con el contrato: base_footprint, base_link, camera_front_optical_frame, sonar_*_frame. -->
<robot name="double3">
  <material name="dark"><color rgba="0.15 0.15 0.17 1"/></material>
  <material name="light"><color rgba="0.85 0.86 0.88 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.09"/>
      <geometry><box size="0.26 0.38 0.18"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- Mástil fijo (parte baja del pole) -->
  <link name="mast_link">
    <visual>
      <origin xyz="0 0 0.42"/>
      <geometry><cylinder radius="0.025" length="0.66"/></geometry>
      <material name="light"/>
    </visual>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="0 0 0.09"/>
  </joint>

  <!-- Pole motorizado: base.pole.setTarget (0..1) -> 0..0.33 m -->
  <link name="pole_link">
    <visual>
      <origin xyz="0 0 -0.15"/>
      <geometry><cylinder radius="0.02" length="0.30"/></geometry>
      <material name="light"/>
    </visual>
  </link>
  <joint name="pole_joint" type="prismatic">
    <parent link="mast_link"/>
    <child link="pole_link"/>
    <origin xyz="0 0 0.75"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.33" effort="50" velocity="0.08"/>
  </joint>

  <!-- Cabeza con tilt: tilt.target (0 arriba .. 1 abajo) -> -0.35..0.35 rad (pitch positivo = abajo) -->
  <link name="head_link">
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="0.04 0.19 0.25"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="head_tilt_joint" type="revolute">
    <parent link="pole_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.25"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="5" velocity="1.0"/>
  </joint>

  <link name="camera_front_link"/>
  <joint name="camera_front_joint" type="fixed">
    <parent link="head_link"/>
    <child link="camera_front_link"/>
    <origin xyz="0.03 0 0.23"/>
  </joint>
  <link name="camera_front_optical_frame"/>
  <joint name="camera_front_optical_joint" type="fixed">
    <parent link="camera_front_link"/>
    <child link="camera_front_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- 5 ultrasonidos en el frente de la base, de izquierda a derecha (validar orden en el lab) -->
  <link name="sonar_left_frame"/>
  <joint name="sonar_left_joint" type="fixed">
    <parent link="base_link"/><child link="sonar_left_frame"/>
    <origin xyz="0.07 0.17 0.12" rpy="0 0 1.2"/>
  </joint>
  <link name="sonar_front_left_frame"/>
  <joint name="sonar_front_left_joint" type="fixed">
    <parent link="base_link"/><child link="sonar_front_left_frame"/>
    <origin xyz="0.12 0.10 0.12" rpy="0 0 0.6"/>
  </joint>
  <link name="sonar_front_frame"/>
  <joint name="sonar_front_joint" type="fixed">
    <parent link="base_link"/><child link="sonar_front_frame"/>
    <origin xyz="0.13 0 0.12"/>
  </joint>
  <link name="sonar_front_right_frame"/>
  <joint name="sonar_front_right_joint" type="fixed">
    <parent link="base_link"/><child link="sonar_front_right_frame"/>
    <origin xyz="0.12 -0.10 0.12" rpy="0 0 -0.6"/>
  </joint>
  <link name="sonar_right_frame"/>
  <joint name="sonar_right_joint" type="fixed">
    <parent link="base_link"/><child link="sonar_right_frame"/>
    <origin xyz="0.07 -0.17 0.12" rpy="0 0 -1.2"/>
  </joint>
</robot>
