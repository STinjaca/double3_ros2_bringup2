<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>d3_bringup2</name>
  <version>0.1.0</version>
  <description>Bringup ROS 2 del Double 3 con el mismo contrato que naoqi_bringup2_SinfonIA (launch, configuración y secuencia de arranque).</description>
  <maintainer email="111019208+STinjaca@users.noreply.github.com">Santi T</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>d3_agent</exec_depend>
  <exec_depend>d3_capabilities</exec_depend>
  <exec_depend>d3_description</exec_depend>
  <exec_depend>d3_driver</exec_depend>
  <exec_depend>d3_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
