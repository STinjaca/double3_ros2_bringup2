# Copia este archivo a `.env` (está en .gitignore) y llena los valores reales.
# Nunca subas el archivo .env al repositorio.

# IP del Double 3 en la red del laboratorio. Ejemplo con un rango de documentación (RFC 5737).
D3_IP=192.0.2.10
# Puerto TCP que abre d3_agent en el robot.
D3_PORT=22022
# Token compartido con d3_agent. Genéralo con: python3 -c "import secrets; print(secrets.token_hex(24))"
D3_TOKEN=changeme

# IP de este equipo (Mac o PC) en la LAN. La pantalla del D3 la usa para abrir web_video_server.
# En Linux con network_mode: host se puede dejar vacía y se autodetecta.
HOST_IP=

# Identificador de dominio DDS (único por equipo de trabajo en el laboratorio).
ROS_DOMAIN_ID=42

# Puertos del host (cámbialos si otro programa ya los usa). Dentro del contenedor no cambian.
VIDEO_HOST_PORT=8080
ROSBRIDGE_HOST_PORT=9090
FOXGLOVE_HOST_PORT=8765

# Segundos para que d3_agent dé por muerto el enlace de control y detenga el robot (0 = tiempos del SO).
# Se usa en el robot (servicio d3-agent), no en el contenedor.
# D3_LINK_TIMEOUT=3

# Reglas extra para tools/check_public_safety.py (hook de pre-commit). Crea `.public_safety.local` en la
# raíz del repo (está en .gitignore) con los rangos y términos de tu despliegue, uno por línea:
#   net: 198.51.100.0/24
#   term: nombre-del-sitio
# Si lo guardas en otra ruta, exporta la variable en tu shell (pre-commit no lee este .env):
# PUBLIC_SAFETY_LOCAL=/ruta/a/mis_reglas.local
